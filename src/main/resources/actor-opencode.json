{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "deny"
    },
    "write": {
      "*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "deny"
    },
    "external_directory": {
      "/root/.local/share/opencode/tool-output": "allow",
      "/root/.local/share/opencode/tool-output/*": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "metaverse_mcp": {
      "type": "remote",
      "url": "http://opensim-metaverse2mcp-%bot.first%-%bot.last%:%env.METAVERSE_MCP_PORT%%env.METAVERSE_MCP_HTTP_ENDPOINT%",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer %bot.token%"
      }
    }
  }
}
