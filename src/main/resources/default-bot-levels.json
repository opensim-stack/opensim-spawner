						"OPENSIM_BOT_FIRST": "%bot.first%",
						"OPENSIM_BOT_LAST": "%bot.last%",
						"OPENSIM_BOT_PASSWORD": "%bot.password%",
						"OPENSIM_LOGIN_URI": "%env.OPENSIM_LOGIN_URI%",
						"OPENSIM_LOGIN_START": "%env.OPENSIM_LOGIN_START%",
						"OPENSIM_HANDLER_CONFIG": "%env.OPENSIM_HANDLER_CONFIG%",
						"VOICE_ROUTING_ENABLED": "%env.VOICE_ROUTING_ENABLED%",
						"VOICE_BACKEND": "%env.VOICE_BACKEND%",
						"PIPER_HOST": "%env.PIPER_HOST%",
