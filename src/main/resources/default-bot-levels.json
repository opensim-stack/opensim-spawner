{
	"name": "bots",
	"constants": {
        "OPENSIM_OPENCODE_IMAGE": "%cfg.group%opensim-opencode:%grid.updates.tag%",
        "OPENSIM_METAVERSE2MCP_IMAGE": "%cfg.group%opensim-metaverse2mcp:%grid.updates.tag%",
        "OPENCODE_HOST" : "0.0.0.0",
        "OPENCODE_PORT" : "8998",
        "OPENCODE_SCHEME" : "http",
        "OPENCODE_INITIAL_PROVIDER": "",
        "OPENCODE_INITIAL_MODEL": "",
        "OPENCODE_REQUEST_TIMEOUT_SECONDS" : "1800",
        "METAVERSE_MCP_TRANSPORT": "http",
        "METAVERSE_MCP_HOST": "0.0.0.0",
        "METAVERSE_MCP_PORT": "8999",
        "METAVERSE_MCP_HTTP_ENDPOINT": "/mcp",
        "METAVERSE_MCP_HTTP_DISALLOW_DELETE": "false",
        "METAVERSE_MCP_DIAGNOSTICS": "false", 
        "OPENSIM_HANDLER_CONFIG" : "/config/handlers.json",
        "PROMPT_HANDLING_ENABLED" : "true",
        "PROMPT_PROJECT_AGENTS_ENABLED" : "true",
        "PROMPT_NOTECARD_REQUIRE_HANDLER" : "true",
        "OPENCODE_SERVER_EXTRA_ARGS" : "",
        "OPENSIM_LOGIN_START": "last",
        "OPENSIM_LOGIN_TIMEOUT_SECONDS" : "30",
        "SPAWNER_HOST": "%cfg.projectName%-spawner",
        "OPENSIM_LOGIN_URI": "http://%cfg.projectName%-grid-services:9000"
    },
	"tokens": [],
	"exports": [
	],
	"extensions": {
		"GOVERNOR": {
			"level": 0,
			"appearance": "Professional",
			"containers": {
				"%env.OPENSIM_OPENCODE_IMAGE%": {
					"name": "%cfg.projectName%-opencode-%bot.first%-%bot.last%",
					"environment": {
						"OPENCODE_HOST": "%env.OPENCODE_HOST%",
						"OPENCODE_PORT": "%env.OPENCODE_PORT%",
						"OPENCODE_PROJECT_DIR": "/workspace/bots/%bot.first%-%bot.last%",
						"OPENCODE_CONFIG": "/config/bots/%bot.first%-%bot.last%/opencode.json",
						"OPENCODE_SERVER_PASSWORD": "%bot.password%",
						"OPENCODE_SERVER_USERNAME": "%bot.first%%bot.last%",
						"OPENCODE_DEFAULT_PROMPT_PATH": "/config/bots/%bot.first%-%bot.last%/AGENTS.md"
					},
					"volumes": {
						"%cfg.projectName%_opensim-workspace": "/workspace",
						"%cfg.projectName%-opensim-opencode-state-%bot.first%-%bot.last%": "/root/.local/state/opencode",
						"%cfg.projectName%-opensim-opencode-tool-output-%bot.first%-%bot.last%": "/root/.local/share/opencode/tool-output",
						"%cfg.projectName%_opencode-config": "/root/.config/opencode",
						"%cfg.projectName%_opencode-data": "/root/.local/share/opencode",
						"%cfg.projectName%_opencode-cache": "/root/.cache/opencode",
						"%cfg.projectName%_opensim-config": "/config"
					},
					"managed": [
						{
							"resource": "governor-opencode.json",
							"target": "/config/bots/%bot.first%-%bot.last%/opencode.json",
							"dropIns": "/config/drop-ins/opencode/opencode.json.d"
						}
					],
					"files": {
						"/config/bots/%bot.first%-%bot.last%/opencode.json": "governor-opencode.json",
						"/config/bots/%bot.first%-%bot.last%/AGENTS.md": "agent-md/GOVERNOR.md"
					}
				},
				"%env.OPENSIM_METAVERSE2MCP_IMAGE%": {
					"name": "%cfg.projectName%-metaverse2mcp-%bot.first%-%bot.last%",
					"environment": {
						"METAVERSE_MCP_TRANSPORT": "%env.METAVERSE_MCP_TRANSPORT%",
						"METAVERSE_MCP_HOST": "%env.METAVERSE_MCP_HOST%",
						"METAVERSE_MCP_PORT": "%env.METAVERSE_MCP_PORT%",
						"METAVERSE_MCP_HTTP_ENDPOINT": "%env.METAVERSE_MCP_HTTP_ENDPOINT%",
						"METAVERSE_MCP_DIAGNOSTICS": "%env.METAVERSE_MCP_DIAGNOSTICS%",
						"METAVERSE_MCP_HTTP_BEARER_TOKEN": "%bot.token%",
						"SPAWNER_HOST": "%env.SPAWNER_HOST%",
						"SPAWNER_PORT": "%env.OPENSIM_SPAWNER_HTTP_PORT%",
						"SPAWNER_TOKEN": "%token.SPAWNER_TOKEN%",
						"OPENSIM_NETWORK": "%cfg.network%",
						"OPENCODE_SERVER_PASSWORD": "%bot.password%",
						"OPENCODE_SERVER_USERNAME": "%bot.first%%bot.last%",
						"OPENCODE_PORT": "%env.OPENCODE_PORT%",
						"OPENCODE_HOST": "%cfg.projectName%-opencode-%bot.first%-%bot.last%",
						"OPENCODE_SCHEME": "%env.OPENCODE_SCHEME%",
						"OPENCODE_INITIAL_PROVIDER": "%env.OPENCODE_INITIAL_PROVIDER%",
						"OPENCODE_INITIAL_MODEL": "%env.OPENCODE_INITIAL_MODEL%",
						"OPENCODE_REQUEST_TIMEOUT_SECONDS": "%env.OPENCODE_REQUEST_TIMEOUT_SECONDS%",
						"OPENSIM_SPAWNER_PARENT": "%bot.parent%",
						"OPENSIM_SPAWNER_LEVEL": "%bot.level%",
						"OPENSIM_BOT_FIRST": "%bot.first%",
						"OPENSIM_BOT_LAST": "%bot.last%",
						"OPENSIM_BOT_PASSWORD": "%bot.password%",
						"OPENSIM_LOGIN_URI": "%env.OPENSIM_LOGIN_URI%",
						"OPENSIM_LOGIN_START": "%env.OPENSIM_LOGIN_START%",
						"OPENSIM_HANDLER_CONFIG": "%env.OPENSIM_HANDLER_CONFIG%",
                        "OPENSIM_PROJECT_NAME": "%cfg.projectName%",
						"VOICE_ROUTING_ENABLED": "%env.VOICE_ROUTING_ENABLED%",
						"VOICE_BACKEND": "%env.VOICE_BACKEND%",
						"PIPER_HOST": "%env.PIPER_HOST%",
						"PIPER_PORT": "%env.PIPER_PORT%",
						"PIPER_SCHEME": "%env.PIPER_SCHEME%",
						"PIPER_TTS_PATH": "%env.PIPER_TTS_PATH%",
						"PIPER_VOICE_PATH": "%env.PIPER_VOICE_PATH%",
						"PIPER_RESAMPLE_PATH": "%env.PIPER_RESAMPLE_PATH%",
						"PIPER_DEFAULT_VOICE": "%env.PIPER_DEFAULT_VOICE%",
						"PROMPT_HANDLING_ENABLED": "%env.PROMPT_HANDLING_ENABLED%",
						"PROMPT_PROJECT_AGENTS_ENABLED": "%env.PROMPT_PROJECT_AGENTS_ENABLED%",
						"PROMPT_NOTECARD_REQUIRE_HANDLER": "%env.PROMPT_NOTECARD_REQUIRE_HANDLER%",
						"PROMPT_PROJECT_AGENTS_FILE": "/config/bots/%bot.first%-%bot.last%/AGENTS.md",
						"OPENCODE_DEFAULT_PROMPT_PATH": "/config/bots/%bot.first%-%bot.last%/AGENTS.md",
						"WEAR_FOLDER_NAME": "%env.WEAR_FOLDER_NAME%",
						"OPENCODE_SERVER_EXTRA_ARGS": "%env.OPENCODE_SERVER_EXTRA_ARGS%",
						"OPENSIM_LOGIN_TIMEOUT_SECONDS": "%env.OPENSIM_LOGIN_TIMEOUT_SECONDS%"
					},
					"volumes": {
						"%cfg.projectName%_opensim-config": "/config"
					}
				}
			}
		},
