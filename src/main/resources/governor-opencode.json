{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "write": {
      "/workspace/bots/%bot.first%-%bot.last%/**": "allow",
      "/workspace/bots/%bot.first%-%bot.last%": "allow",
      "/workspace": "allow",
      "/workspace/**": "allow",
      "/config/**": "ask",
      "*": "deny"
    },
    "edit": {
      "/workspace/**": "ask",
      "/workspace": "ask",
      "/workspace/bots/%bot.first%-%bot.last%/**": "allow",
      "/workspace/bots/%bot.first%-%bot.last%": "allow",
      "/config/**": "ask",
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "sleep *": "allow",
      "file *": "allow",
      "sum *": "allow"
    },
    "external_directory": {
      "/workspace/**": "allow",
      "/workspace": "allow",
      "/config": "ask",
      "/config/*": "ask",
      "/root/.local/share/opencode/tool-output": "allow",
      "/root/.local/share/opencode/tool-output/*": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "local_host_mcp": {
      "type": "remote",
      "url": "http://%env.COMPOSE_PROJECT_NAME%-console2mcp-1:%env.CONSOLE_MCP_PORT%/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer %env.CONSOLE_MCP_BEARER_TOKEN%"
      }
    },
    "metaverse_mcp": {
      "type": "remote",
      "url": "http://%env.COMPOSE_PROJECT_NAME%-metaverse2mcp-%bot.first%-%bot.last%:%env.METAVERSE_MCP_PORT%%env.METAVERSE_MCP_HTTP_ENDPOINT%",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer %bot.token%"
      }
    },
    "blender_mcp": {
      "type": "remote",
      "url": "http://%env.COMPOSE_PROJECT_NAME%-blender-1:%env.BLENDER_MCP_PORT%/mcp",
      "enabled": true
    }
  }
}
