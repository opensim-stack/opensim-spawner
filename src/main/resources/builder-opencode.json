{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "/workspace/bots/%bot.first%-%bot.last%/**", "effect": "allow" },
    { "action": "read", "resource": "/workspace/bots/%bot.first%-%bot.last%", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "/workspace/bots/%bot.first%-%bot.last%/**", "effect": "allow" },
    { "action": "edit", "resource": "/workspace/bots/%bot.first%-%bot.last%", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/root/.local/share/opencode/tool-output", "effect": "allow" },
    { "action": "external_directory", "resource": "/root/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "metaverse2mcp": {
        "type": "remote",
        "url": "http://%cfg.projectName%-metaverse2mcp-%bot.first%-%bot.last%:%env.METAVERSE_MCP_PORT%%env.METAVERSE_MCP_HTTP_ENDPOINT%",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer %bot.token%"
        }
      }
    }
  }
}
